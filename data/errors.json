    {
      "id": "err-whose-not-that-their",
      "category": "grammar:portuguese-calque-relative-clause",
      "examples": [
        {
          "said": "words that I don't know their meaning",
          "correct": "words whose meaning I don't know / words I don't know",
          "session": "2026-10-19"
        }
      ],
      "rule": "Use \"whose\" instead of \"that … their\" for possession in relative clauses.",
      "first_seen": "2026-10-19",
      "occurrences": 1,
      "severity": "high",
      "ease": 2.5,
      "interval_days": 1,
      "repetitions": 0,
