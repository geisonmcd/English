      "last_reviewed": null
    },
    {
      "id": "err-famous-for-common",
      "category": "word-choice:collocation",
      "examples": [
        {
          "said": "words are most fa- famous that I don't know",
          "correct": "words are most common that I don't know / the most common words I don't know",
          "session": "2026-10-19"
        }
      ],
      "rule": "\"Famous\" is for people/places; for frequency use \"common\" / \"frequent\".",
