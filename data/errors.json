    },
    {
      "id": "err-know-of-vs-know",
      "category": "word-choice:know-of",
      "examples": [
        {
          "said": "words … that I don't know of",
          "correct": "words I don't know",
          "session": "2026-10-19"
        }
      ],
      "rule": "\"Know of\" means being aware something exists; for knowing a word's meaning, say \"know\".",
