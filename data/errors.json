    {
      "id": "err-indirect-question-called",
      "category": "grammar:indirect-question-word-order",
      "examples": [
        {
          "said": "What is, what is called the method that AnkiDroid uses",
          "correct": "What's the method AnkiDroid uses called? / What's it called, the method AnkiDroid uses?",
          "session": "2026-10-19"
        }
      ],
      "rule": "In \"what is X called?\", the subject (X) goes between \"is\" and \"called\".",
      "first_seen": "2026-10-19",
      "occurrences": 1,
      "severity": "high",
      "ease": 2.6,
      "interval_days": 1,
      "repetitions": 1,
      "due_date": "2026-10-20",
      "last_reviewed": "2026-10-19",
      "notes": "Corrected in chat on 2026-10-19 (pass)."
    },
    {
      "id": "err-teach-needs-object",
      "category": "grammar:transitive-verb-missing-object",
      "examples": [
        {
          "said": "teach how to run the application",
          "correct": "teach them how to run the application / show how to run",
          "session": "2026-10-19"
        }
      ],
      "rule": "\"teach\" normally needs the person: teach someone (how) to do something.",
      "first_seen": "2026-10-19",
