    {
      "id": "err-known-words-redundant",
      "category": "word-choice:redundancy",
      "examples": [
        {
          "said": "all the known words that I know",
          "correct": "all the words I already know",
          "session": "2026-10-19"
        },
        {
          "said": "store all my known words",
          "correct": "store the words I already know",
          "session": "2026-10-19"
        }
      ],
      "rule": "Avoid \"known words that I know\" (redundant); \"my known words\" sounds unnatural.",
      "first_seen": "2026-10-19",
      "occurrences": 2,
      "severity": "medium",
      "ease": 2.5,
      "interval_days": 1,
      "repetitions": 0,
