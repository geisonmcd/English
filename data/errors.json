    {
      "id": "err-word-repetition-fillers",
      "category": "fluency:repetitions-fillers",
      "examples": [
        {
          "said": "a, a / we, we / at our, at our / that, that / the, the",
          "correct": "(pause silently or use um / so)",
          "session": "2026-10-19"
        },
        {
          "said": "my, to another / could be, this could be / the, the / what's, what's",
          "correct": "(pause silently or use um / so)",
          "session": "2026-10-19"
        },
        {
          "said": "at this, at the exact time / not, not / in a, in a",
          "correct": "(pause silently or use um / so)",
          "session": "2026-10-19"
        }
      ],
      "rule": "Frequent word repetition while thinking; practice pausing silently or using fillers like \"um\" / \"so\".",
      "first_seen": "2026-10-19",
      "occurrences": 3,
      "severity": "low",
      "ease": 2.5,
      "interval_days": 1,
      "repetitions": 0,
      "due_date": "2026-10-20",
      "last_reviewed": null
    },
    {
      "id": "err-not-x-but-y",
